 "narration": [
  {
   "id": "n01",
   "start": 1.2,
   "end": 4.4,
   "text": "Quanto vale uma hora do seu tempo?"
  },
  {
   "id": "n02",
   "start": 6.5,
   "end": 10.9,
   "text": "Agora imagine quantas horas sua empresa perde todos os meses."
  },
  {
   "id": "n03",
   "start": 12.444,
   "end": 13.778,
   "text": "Preenchendo planilhas."
  },
  {
   "id": "n04",
   "start": 16.364,
   "end": 17.818,
   "text": "Procurando informações."
  },
  {
   "id": "n05",
   "start": 21.246,
   "end": 22.314,
   "text": "Repetindo tarefas."
  },
  {
   "id": "n06",
   "start": 25.703,
   "end": 28.574,
   "text": "Organizando processos que poderiam ser automáticos."
  },
  {
   "id": "n07",
   "start": 30.213,
   "end": 35.463,
   "text": "Enquanto você administra problemas, poderia estar administrando o crescimento da sua empresa."
  },
  {
   "id": "n08a",
   "start": 37.029,
   "end": 39.429,
   "text": "A ArmeTec desenvolve sistemas personalizados"
  },
  {
   "id": "n08b",
   "start": 39.686,
   "end": 41.4,
   "text": "que simplificam processos,"
  },
  {
   "id": "n08c",
   "start": 42.514,
   "end": 44.143,
   "text": "centralizam informações"
  },
  {
   "id": "n08d",
   "start": 45.514,
   "end": 47.229,
   "text": "e automatizam rotinas."
  },
  {
   "id": "n09",
   "start": 49.062,
   "end": 57.0,
   "text": "Receba diariamente, direto no seu WhatsApp, relatórios automáticos com os resultados, indicadores e um resumo completo do dia da sua empresa."
  },
  {
   "id": "n10a",
   "start": 61.24,
   "end": 65.446,
   "text": "E você não precisa estar dentro da sua empresa para estar no controle dela."
  },
  {
   "id": "n10b",
   "start": 66.177,
   "end": 72.76,
   "text": "Acesse seu sistema pelo celular, notebook ou computador, de onde estiver, com a praticidade de um aplicativo."
  },
  {
   "id": "n11",
   "start": 76.9,
   "end": 78.1,
   "text": "Menos tarefas."
  },
  {
   "id": "n12",
   "start": 78.9,
   "end": 80.1,
   "text": "Mais controle."
  },
  {
   "id": "n13",
   "start": 80.9,
   "end": 82.4,
   "text": "Mais produtividade."
  },
  {
   "id": "n14",
   "start": 82.9,
   "end": 85.0,
   "text": "Mais tempo para crescer."
  },
  {
   "id": "n15",
   "start": 86.773,
   "end": 87.627,
   "text": "ArmeTec."
  },
  {
   "id": "n16",
   "start": 88.16,
   "end": 90.507,
   "text": "Tecnologia que devolve o seu tempo."
  }
 ],
