  "narration": [
    {"id": "n01", "start": 1.2, "end": 4.4, "text": "Quanto vale uma hora do seu tempo?"},
    {"id": "n02", "start": 6.5, "end": 10.9, "text": "Agora imagine quantas horas sua empresa perde todos os meses."},
    {"id": "n03", "start": 12.5, "end": 14.0, "text": "Preenchendo planilhas."},
    {"id": "n04", "start": 16.9, "end": 18.5, "text": "Procurando informações."},
    {"id": "n05", "start": 22.3, "end": 23.6, "text": "Repetindo tarefas."},
    {"id": "n06", "start": 27.7, "end": 30.5, "text": "Organizando processos que poderiam ser automáticos."},
    {"id": "n07", "start": 32.2, "end": 38.2, "text": "Enquanto você administra problemas, poderia estar administrando o crescimento da sua empresa."},
    {"id": "n08a", "start": 40.0, "end": 42.8, "text": "A ArmeTec desenvolve sistemas personalizados"},
    {"id": "n08b", "start": 43.1, "end": 45.1, "text": "que simplificam processos,"},
    {"id": "n08c", "start": 46.4, "end": 48.3, "text": "centralizam informações"},
    {"id": "n08d", "start": 49.9, "end": 51.9, "text": "e automatizam rotinas."},
    {"id": "n09", "start": 54.0, "end": 62.6, "text": "Receba diariamente, direto no seu WhatsApp, relatórios automáticos com os resultados, indicadores e um resumo completo do dia da sua empresa."},
    {"id": "n10a", "start": 67.2, "end": 71.8, "text": "E você não precisa estar dentro da sua empresa para estar no controle dela."},
    {"id": "n10b", "start": 72.6, "end": 79.8, "text": "Acesse seu sistema pelo celular, notebook ou tablet, de onde estiver, com a praticidade de um aplicativo."},
    {"id": "n11", "start": 84.3, "end": 85.5, "text": "Menos tarefas."},
    {"id": "n12", "start": 86.3, "end": 87.5, "text": "Mais controle."},
    {"id": "n13", "start": 88.3, "end": 89.8, "text": "Mais produtividade."},
    {"id": "n14", "start": 90.3, "end": 92.4, "text": "Mais tempo para crescer."},
    {"id": "n15", "start": 94.1, "end": 94.9, "text": "ArmeTec."},
    {"id": "n16", "start": 95.4, "end": 97.6, "text": "Tecnologia que devolve o seu tempo."}
  ],
